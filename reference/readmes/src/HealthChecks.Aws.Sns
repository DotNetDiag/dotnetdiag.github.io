}
</code></pre>
<h3 id="check-existence-of-a-topic-its-subscriptions-and-specify-credentials-with-region-endpoint">Check existence of a topic, its subscriptions and specify credentials with region endpoint</h3>
<pre><code class="language-csharp">public void ConfigureServices(IServiceCollection services)
{
    services
        .AddHealthChecks()
